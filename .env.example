# Copy this file to .env and fill in real values. Never commit .env itself.

POSTGRES_DB=dpr_monitor
POSTGRES_USER=dpr_monitor
POSTGRES_PASSWORD=change-me

# Ollama runs on the host machine, not in this compose stack.
# host.docker.internal resolves to the host from inside the app container.
OLLAMA_HOST=http://host.docker.internal:11434
# CPU-only hardware (docs/07_non_functional_requirements.md) -- benchmark
# on real narratives before changing; see docs/05_architecture.md.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Host port for Postgres. Change if 5432 is already taken on this machine
# (and point DATABASE_URL at the same port for local, non-Docker runs).
POSTGRES_HOST_PORT=5432

# Where the original uploaded PDFs (the system of record) live on the host.
UPLOAD_HOST_DIR=./data/uploads

# Login sessions (docs/07_non_functional_requirements.md: email + password).
SESSION_HOURS=12
# Set to true once the app is served over HTTPS (e.g. the shared server).
COOKIE_SECURE=false

# Scheduled backups (the `backup` service): a pg_dump every
# BACKUP_INTERVAL_HOURS, dumps older than BACKUP_KEEP_DAYS pruned, and an
# incremental mirror of the uploaded PDFs (never pruned). Point
# BACKUP_HOST_DIR at a different disk or network share than the data.
BACKUP_HOST_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30
